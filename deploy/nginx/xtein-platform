# Xtein Platform: shell + microfrontends (Native Federation) y reenvío de la API del ERP
# Instalar en el servidor (dev2026):
#   sudo cp deploy/nginx/xtein-platform /etc/nginx/sites-available/xtein-platform
#   sudo ln -s /etc/nginx/sites-available/xtein-platform /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo ufw allow 7596/tcp
server {
    listen 7596;
    server_name _;

    # Lo publica deploy/desplegar-platform.sh: el shell en la raíz y cada microfrontend en /<REMOTE_NAME>/
    # (mfe-adm/, mfe-mcom/, ...). El shell de producción busca /<REMOTE_NAME>/remoteEntry.json.
    root /var/www/xtein-platform/browser;
    index index.html;

    client_max_body_size 40m;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Sin caché: cambian en cada despliegue y no llevan hash en el nombre.
    # Va antes que el bloque de /mfe-*/: nginx usa la primera expresión regular que coincide
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
    location ~ (?:remoteEntry|importmap)\.json$ {
        try_files $uri =404;
        add_header Cache-Control "no-cache";
    }

    # Los microfrontends no son SPA: un archivo que no existe es un 404, nunca el index.html del shell
    location ~ ^/mfe-[a-z0-9-]+/ {
        try_files $uri =404;

        location ~ \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
        }
    }

    # Archivos con hash en el nombre (main-XXXX.js, styles-XXXX.css): no cambian nunca, caché larga
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpg|jpeg|webp|ico)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Diseñador de dashboards (mismo destino que apps/shell/proxy.conf.json)
    location /api/dashboard-designer {
        proxy_pass http://192.168.11.153:7179;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 300s;
    }

    # API del ERP (apiRest de este mismo servidor: pm2 "apirest", puerto 5900). Sin URI en proxy_pass: la ruta /api/... llega igual
    location /api/ {
        proxy_pass http://127.0.0.1:5900;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
