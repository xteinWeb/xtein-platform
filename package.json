{
    "name": "xtein-platform",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "node --max-old-space-size=14336 ./node_modules/@angular/cli/bin/ng serve --port 4795 --proxy-config proxy.conf.json",
        "start-no-proxy": "node --max-old-space-size=14336 ./node_modules/@angular/cli/bin/ng serve --port 4795",
        "start-optimized": "node --max-old-space-size=14336 ./node_modules/@angular/cli/bin/ng serve --port 4795 --configuration dev-server --proxy-config proxy.conf.json",
        "start-fast": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng serve --port 4795 --configuration development --proxy-config proxy.conf.json",
        "build": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build",
        "build-prod": "node --max-old-space-size=8192 ./node_modules/@angular/cli/bin/ng build --configuration production",
        "watch": "node --max-old-space-size=14336 ./node_modules/@angular/cli/bin/ng build --watch --configuration development",
        "test": "ng test",
        "proxy": "ng serve --port 4800 --proxy-config proxy.conf.json",
        "serve-prod": "node --max-old-space-size=14336 ./node_modules/@angular/cli/bin/ng serve --configuration production --port 4795",
        
        "build:libs": "npx ng build sdk && npx ng build logging && npx ng build session && npx ng build api-client && npx ng build runtime && npx ng build dashboard-runtime && npx ng build ui && npx ng build auth",
        "build:apps": "npx ng build mfe-adm && npx ng build mfe-dashboard && npx ng build mfe-inv && npx ng build mfe-mad && npx ng build mfe-malm && npx ng build mfe-mcom && npx ng build mfe-mcpr && npx ng build mfe-men && npx ng build mfe-mfin && npx ng build mfe-mthu && npx ng build shell",
        "build:all": "npm run build:libs && npm run build:apps",
        "serve:shell": "npx ng serve shell",
        "serve:adm": "npx ng serve mfe-adm",
        "serve:dashboard": "npx ng serve mfe-dashboard",
        "serve:inv": "npx ng serve mfe-inv",
        "serve:mad": "npx ng serve mfe-mad",
        "serve:malm": "npx ng serve mfe-malm",
        "serve:mcom": "npx ng serve mfe-mcom",
        "serve:mcpr": "npx ng serve mfe-mcpr",
        "serve:men": "npx ng serve mfe-men",
        "serve:mfin": "npx ng serve mfe-mfin",
        "serve:mthu": "npx ng serve mfe-mthu",
        "serve:all": "concurrently --kill-others-on-fail -n SHELL,ADM,DASH,INV,MAD,MALM,MCOM,MCPR,MEN,MFIN,MTHU \"npm run serve:shell\" \"npm run serve:adm\" \"npm run serve:dashboard\" \"npm run serve:inv\" \"npm run serve:mad\" \"npm run serve:malm\" \"npm run serve:mcom\" \"npm run serve:mcpr\" \"npm run serve:men\" \"npm run serve:mfin\" \"npm run serve:mthu\"",
        "dev:all": "npm run build:libs && npm run serve:all"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "21.2.22",
        "@angular/cdk": "^21.2.14",
        "@angular/common": "21.2.22",
        "@angular/compiler": "21.2.22",
        "@angular/core": "21.2.22",
        "@angular/forms": "21.2.22",
        "@angular/material": "^21.2.14",
        "@angular/platform-browser": "21.2.22",
        "@angular/platform-browser-dynamic": "21.2.22",
        "@angular/router": "21.2.22",
        "@devexpress/analytics-core": "25.2",
        "@softarc/native-federation-node": "^3.3.4",
        "angular-oauth2-oidc": "^19.0.0",
        "angular-split": "^14.1.0",
        "bcryptjs": "^2.4.3",
        "bn-ng-idle": "^2.0.5",
        "bootstrap": "^5.2.3",
        "devexpress-dashboard": "25.2",
        "devexpress-dashboard-angular": "25.2",
        "devexpress-reporting": "25.2",
        "devexpress-reporting-angular": "25.2",
        "devexpress-richedit": "25.2",
        "devextreme": "25.2",
        "devextreme-angular": "25.2",
        "es-module-shims": "^1.5.12",
        "exceljs": "^4.3.0",
        "file-saver": "^2.0.5",
        "jquery-ui": "^1.13.2",
        "jspdf": "^2.5.1",
        "primeng": "^21.1.9",
        "rxjs": "~7.8.2",
        "socket.io-client": "^4.7.2",
        "stompjs": "^2.3.3",
        "sweetalert2": "^11.6.13",
        "tslib": "^2.3.0",
        "xlsx": "^0.18.5",
        "zone.js": "~0.15.1"
    },
    "devDependencies": {
        "@angular-architects/native-federation": "^21.2.5",
        "@angular-devkit/build-angular": "21.2.22",
        "@angular/build": "21.2.22",
        "@angular/cli": "21.2.22",
        "@angular/compiler-cli": "21.2.22",
        "@types/jasmine": "~4.3.0",
        "concurrently": "^9.2.4",
        "jasmine-core": "~4.5.0",
        "jsdom": "^28.0.0",
        "karma": "~6.4.0",
        "karma-chrome-launcher": "~3.1.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.0.0",
        "ng-packagr": "^21.2.0",
        "typescript": "~5.9.3",
        "vitest": "^4.0.8"
    }
}
